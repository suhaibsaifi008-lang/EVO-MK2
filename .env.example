# ---- Model router (any OpenAI-compatible endpoint; Ollama = offline fallback) ----
JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_OPENAI_MODEL=gpt-4o-mini

# Role overrides (optional)
# JARVIS_MODEL_FAST=
# JARVIS_MODEL_REASONING=
# JARVIS_MODEL_FALLBACK=

# ---- Realtime voice (free key: aistudio.google.com) ----
GEMINI_API_KEY=
# JARVIS_GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
# JARVIS_VOICE_ENGINE=auto   # auto|live|vosk

# ---- Identity ----
EVO_NAME=EVO
EVO_USER_ADDRESS=sir

# Voice mode: PTT button only (recommended). Set 1 to re-enable wake word.
EVO_WAKE=0

# ---- Phase 2: Communication ----
# Telegram: create a bot with @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=
# Email reading/sending. Use an APP PASSWORD, never your real password.
MAIL_ADDRESS=
MAIL_PASSWORD=
# Gmail example: MAIL_IMAP_HOST=imap.gmail.com / MAIL_SMTP_HOST=smtp.gmail.com
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
# MASTER SWITCH for sending email. Drafts work without it; sending does not.
MAIL_SEND_ENABLED=0
# Push notifications: pick a long random topic name, subscribe to it in the
# ntfy phone app. Example: NTFY_TOPIC=evo-suhaib-7f3k9x2m
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Surface switches (0 disables)
EVO_TELEGRAM=1
EVO_PUSH=1

# ---- Voice transcription (PTT button) ----
# auto = Gemini cloud STT (best quality) -> local Whisper -> Vosk
# EVO_STT_ENGINE=auto      # auto|gemini|whisper|vosk
# EVO_STT_MODEL=small.en   # local whisper fallback size
# EVO_GEMINI_STT_MODEL=gemini-2.5-flash

# ---- Phase 7: The Relationship ----
# EVO's personality lives in data/vault/persona.md - edit it freely.
# Unprompted messages: max per day + quiet hours (no initiations then).
EVO_INITIATIVE_MAX=3
EVO_QUIET_START=23
EVO_QUIET_END=8

# ---- Search page EVO opens when you ask it to search ----
# EVO_SEARCH_ENGINE=google # google|brave|duckduckgo|bing
# EVO_SEARCH_URL=          # or a custom template, e.g. https://search.brave.com/search?q={q}
